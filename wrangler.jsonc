// The site is static: Workers serves dist/ as assets, nothing runs server-side.
// Kept in the repo so the deploy does not depend on settings only the
// dashboard knows. The custom domain (svipall.ilien.dev) stays in the dashboard.
{
  "name": "svipall-site",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
