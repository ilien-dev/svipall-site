{
  "name": "svipall-site",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check:rules": "node .ptah/ptah-check.mjs --all",
    "check:links": "node .ptah/check-links.mjs",
    "verify": "npm run build && npm run check:links && npm run check:rules"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0"
  }
}