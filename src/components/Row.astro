---
/*
 * Row — a full-bleed band of the grid. The page is a stack of these.
 *
 * The band spans the window and carries the horizontal rule that separates it
 * from the band above. Its rail carries the two vertical rules, which stack
 * down the page into continuous lines. That stack is the grid, and the grid is
 * the idiom: every block is a cell with a drawn edge, nothing floats.
 *
 * `num` and `label` are the signature: a two-digit number and a mono label in
 * the same corner of every band. They are ink, never accent — the accent is
 * scarce by rule and belongs to the call to action.
 */

interface Props {
  num: string;
  label: string;
  class?: string;
}

const { num, label, class: className = '' } = Astro.props;
---

<section class={`row ${className}`}>
  <div class="row__rail">
    <p class="row__eyebrow">
      <span class="row__num">{num}</span>
      <span class="row__slash" aria-hidden="true">/</span>
      <span class="row__label">{label}</span>
    </p>

    <div class="row__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .row {
    width: 100%;
    /* A minimum gutter, so the rail's vertical rules are always inset and the
       grid reads at every width instead of vanishing off the window edge. */
    padding-inline: var(--space-6);
    border-top: var(--border-hair) solid var(--color-hairline);
  }

  .row__rail {
    width: 100%;
    max-width: var(--rail);
    margin-inline: auto;
    padding: var(--space-7) var(--space-6) var(--space-8);
    border-inline: var(--border-hair) solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .row__eyebrow {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: var(--leading-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .row__num {
    font-weight: 700;
    color: var(--color-ink);
  }

  .row__slash {
    color: var(--color-hairline);
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (max-width: 760px) {
    .row {
      padding-inline: 0;
    }

    .row__rail {
      padding: var(--space-6) var(--space-4) var(--space-7);
      /* Below the rail width the vertical rules sit against the window edge,
         where they read as a frame rather than as a column. */
      border-inline: 0;
      gap: var(--space-5);
    }
  }
</style>
