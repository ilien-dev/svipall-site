---
/*
 * Row — a full-bleed band of the grid. The page is a stack of these.
 *
 * The band spans the window and carries the horizontal rule that separates it
 * from the band above. Its rail carries the two vertical rules, which stack
 * down the page into continuous lines. That stack is the grid, and the grid is
 * the idiom: every block is a cell with a drawn edge, nothing floats.
 *
 * The band carries no eyebrow. It used to be signed `NN / LABEL` in tracked
 * mono, and both halves were doing nothing: the label restated the heading
 * three lines below it, and the number counted a sequence no reader follows in
 * order. The rule at the top of the band separates it; the heading names it.
 *
 * The optional `media` slot is the band's BACKGROUND and nothing else: it is
 * full bleed, it is clipped to the band, and it takes no pointer. It exists
 * because the band is the only element that spans the window - anything the
 * rail holds is capped at --rail and would be a picture in a column, not a
 * ground. The Row owns the box; whatever is slotted into it owns its own
 * paint, and styles it in the file it is written in. A rule written HERE for
 * slotted content carries this component's hash and would never apply.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class={`row ${className}`}>
  {
    hasMedia && (
      <div class="row__media">
        <slot name="media" />
      </div>
    )
  }
  <div class="row__rail">
    <div class="row__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .row {
    position: relative;
    /* Its own stacking context, so a band's media can never reach over the
       band above it and the sticky nav stays over all of them. */
    isolation: isolate;
    width: 100%;
    /* A minimum gutter, so the rail's vertical rules are always inset and the
       grid reads at every width instead of vanishing off the window edge. */
    padding-inline: var(--space-6);
    border-top: var(--border-hair) solid var(--color-hairline);
  }

  /* Full bleed and clipped to the band: the media is exactly as tall as the
     row it sits behind, which is what makes it a ground rather than a block
     with a height of its own. */
  .row__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .row__rail {
    /* Over the media, and the two vertical rules with it: the grid is the
       idiom and it does not go behind a picture. */
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--rail);
    margin-inline: auto;
    padding: var(--space-7) var(--space-6) var(--space-8);
    border-inline: var(--border-hair) solid var(--color-hairline);
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (max-width: 760px) {
    .row {
      padding-inline: 0;
    }

    .row__rail {
      padding: var(--space-6) var(--space-4) var(--space-7);
      /* Below the rail width the vertical rules sit against the window edge,
         where they read as a frame rather than as a column. */
      border-inline: 0;
    }

    .row__body {
      gap: var(--space-5);
    }
  }
</style>
