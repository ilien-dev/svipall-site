---
/*
 * Flow — the three beats of one request. C2 section 3.
 *
 * Numbered 01/02/03. The catalogue refuses numbered markers by default and
 * earns them back for "content that is genuinely a sequence and where the
 * reader needs the order". This is that: you ask, then it goes, then your
 * assistant gets something back. The order is the content.
 */

import Glyph from './Glyph.astro';
import type { GlyphName } from '../lib/glyphs';

interface Beat {
  num: string;
  title: string;
  body: string;
  quote?: string;
  /* The mark names what the BEAT is, not what a step generally looks like:
     you say it, it goes and keeps going, you get the reading back. The number
     already carries the order, so the mark is free to carry the content. */
  mark: GlyphName;
}

interface Props {
  beats: Beat[];
}

const { beats } = Astro.props;
---

<ol class="flow">
  {
    beats.map((beat) => (
      <li class="flow__beat">
        {/* aria-hidden: the <ol> already conveys the order, so a screen
            reader would otherwise hear the position twice. */}
        <div class="flow__gutter">
          <p class="flow__num" aria-hidden="true">{beat.num}</p>
          <Glyph name={beat.mark} size="lg" class="flow__mark" />
        </div>
        <div class="flow__body">
          <h3 class="flow__title">{beat.title}</h3>
          {beat.quote && <p class="flow__quote">{beat.quote}</p>}
          <p class="flow__text">{beat.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* The seams are the 1px gaps in the grid, showing the container's own
     background. Drawing them with per-child borders needs nth-child rules
     that only hold for one item count, and this list has seven. */
  .flow {
    margin: 0;
    display: grid;
    gap: var(--border-hair);
    padding: var(--border-hair);
    background: var(--color-hairline);
  }

  .flow__beat {
    display: grid;
    grid-template-columns: 4ch 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--color-cell);
  }

  /* The number and the mark share the 4ch column the number already had, so
     the mark costs the row no width. Stacked rather than side by side: at 4ch
     they would each be half a character wide. */
  .flow__gutter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .flow__num {
    margin: 0;
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 700;
    line-height: var(--leading-body);
    letter-spacing: 0.12em;
    color: var(--color-ink);
    padding-top: 0.35em;
  }

  .flow__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .flow__title {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }

  /* What the reader would actually say, set as the thing they say. */
  .flow__quote {
    max-width: var(--measure);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink);
    padding-left: var(--space-4);
    border-left: var(--border-hair) solid var(--color-hairline);
  }

  .flow__text {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  @media (min-width: 900px) {
    /* ONE COLUMN, not N-up. A grid of equal bordered blocks each holding a
       heading and a paragraph is a card wall, whatever the CSS calls it, and
       DIRECTION.md's component list rules one out by name. The idiom is a
       RULED BOARD: rows that share edges, with the label in a left column and
       the reading in a right one, which is the same shape section 2 uses and
       the same shape the brief's own reference used. */
    .flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .flow__beat {
      /* base.css caps every <li> at the reading measure, and these rows are
         list items. Under the old two-up grid each column sat below the cap so
         nothing showed; across the full rail the cap held the row at 653px and
         the rest of the track showed the container's own background as a grey
         block. The MEASURE still applies to the text inside; it must not
         apply to the row that carries it. */
      max-width: none;
      grid-template-columns: 4ch minmax(0, 1fr);
      gap: var(--space-5);
    }

    /* The step's name in the left column, what it means in the right. */
    .flow__body {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: var(--space-3) var(--space-6);
      align-items: start;
    }

    .flow__title {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .flow__quote {
      grid-column: 2;
      grid-row: 1;
    }

    .flow__text {
      grid-column: 2;
      grid-row: 2;
      /* Pinned to the top. The beats stretch to a common height, and with the
         default the two rows shared the slack out between them, so each card
         put its heading at a different y and one row of the same component
         resolved heading-against-body three different ways. The other two card
         families in this page top-align; this one now does too. */
      align-content: start;
    }
  }
</style>
