---
/*
 * The docs header is the product page's header: one component, SiteHeader,
 * renders both. Here it gets Starlight's search (kept for its modal and
 * Ctrl+K; the pill in the header opens it) and marks Docs as the current
 * section. Both headers carry `view-transition-name: site-header`, so moving
 * between the product page and the docs keeps the header in place.
 */
import Search from 'virtual:starlight/components/Search';
import SiteHeader from './SiteHeader.astro';
---

<SiteHeader current="docs"><Search slot="search" /></SiteHeader>

<script>
  /* Same key Starlight and the product page use, so the choice follows you. */
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const label = () =>
      button.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
    label();
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('starlight-theme', next); } catch {}
      label();
    });
  }
  /* A search button anywhere on a docs page opens Starlight's search
     (delegated, so it also works on content the router swaps in). */
  const openSearch = () => document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest?.('[data-open-search]')) openSearch();
  });
  /* The product page's search pill lands here as /docs/?search. */
  if (new URLSearchParams(location.search).has('search')) {
    history.replaceState(history.state, '', location.pathname + location.hash);
    customElements.whenDefined('site-search').then(() => requestAnimationFrame(openSearch));
  }
  import '../scripts/docs-router';
</script>

<style>
  @media (max-width:50rem){:global(.dh){padding-inline-end:3rem}}
</style>
