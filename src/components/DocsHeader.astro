---
/*
 * The docs header is the product page's header: same mark, same links, same
 * theme switch, same version chip. Only Starlight's search is added. Both
 * headers carry `view-transition-name: site-header`, so moving between the
 * product page and the docs keeps the header in place while the page below
 * changes.
 */
import Search from 'virtual:starlight/components/Search';
import { latestRelease } from '../lib/release';

const release = await latestRelease();
---

<div class="dh">
  <a class="dh-brand" href="/" aria-label="Svipall home">
    <img class="dh-mark dh-dark" src="/brand/svipall-mark-dark.svg" alt="" width="28" height="33" />
    <img class="dh-mark dh-light" src="/brand/svipall-mark.svg" alt="" width="28" height="33" />
    <svg viewBox="0 0 600 120" width="104" height="21" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="15"><g transform="translate(14,10)"><path d="M66 22 L54 6 L18 6 L6 22 L6 34 L18 44 L54 56 L66 68 L66 78 L54 94 L18 94 L6 78"></path><path transform="translate(92,0)" d="M6 6 L28 94 L44 94 L66 6"></path><path transform="translate(184,0)" d="M14 6 L14 94"></path><path transform="translate(232,0)" d="M8 94 L8 6 L46 6 L64 24 L64 38 L46 54 L8 54"></path><path transform="translate(322,0)" d="M6 94 L28 8 L44 8 L66 94 M18 62 L54 62"></path><path transform="translate(414,0)" d="M10 6 L10 94 L62 94"></path><path transform="translate(500,0)" d="M10 6 L10 94 L62 94"></path></g></g></svg>
  </a>
  <nav class="dh-nav" aria-label="Main">
    <a href="/#flow">How it works</a>
    <a href="/#abilities">Abilities</a>
    <a href="/#apps">Your AI apps</a>
    <a href="/docs/" aria-current="true" class="dh-on">Docs</a>
  </nav>
  <div class="dh-right">
    <Search />
    <button type="button" class="dh-tgl" data-theme-toggle aria-label="Switch colour theme">
      <svg class="dh-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="dh-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    </button>
    {release && <a class="dh-ver" href={release.url} title={`Released ${release.date}`}>{release.version}</a>}
    <a class="dh-get" href="/#get">Get it free</a>
  </div>
</div>

<script>
  /* Same key Starlight and the product page use, so the choice follows you. */
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const label = () =>
      button.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
    label();
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('starlight-theme', next); } catch {}
      label();
    });
  }
  /* A search button anywhere on a docs page opens Starlight's search. */
  for (const trigger of document.querySelectorAll('[data-open-search]')) {
    trigger.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
    });
  }
</script>

<style>
  .dh{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;height:100%}
  .dh-brand{display:flex;align-items:center;gap:.75rem;color:var(--sl-color-white);text-decoration:none;flex:none}
  :root[data-theme='light'] .dh-dark,:root:not([data-theme='light']) .dh-light{display:none}
  .dh-nav{display:flex;gap:1.75rem;font-size:1rem}
  .dh-nav a{color:var(--sl-color-white);text-decoration:none;transition:color .2s}
  .dh-nav a:hover{color:var(--sl-color-text-accent)}
  .dh-nav a.dh-on{color:var(--sl-color-text-accent);font-weight:800;box-shadow:inset 0 -2px 0 var(--sl-color-accent);padding-bottom:4px}
  .dh-right{display:flex;align-items:center;gap:.75rem}
  .dh-tgl{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;border:1px solid var(--sl-color-gray-5);background:transparent;color:var(--sl-color-white);cursor:pointer;transition:transform .3s,background .3s}
  .dh-tgl:hover{transform:rotate(-20deg);background:var(--sl-color-gray-6)}
  .dh-tgl svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;animation:dh-pop .35s cubic-bezier(.2,.7,.2,1) both}
  :root[data-theme='light'] .dh-sun,:root:not([data-theme='light']) .dh-moon{display:none}
  .dh-ver{white-space:nowrap;font-size:13px;font-weight:700;color:var(--sl-color-text-accent);text-decoration:none;border:1px solid var(--sl-color-gray-5);border-radius:999px;padding:7px 12px}
  .dh-get{display:inline-flex;white-space:nowrap;flex:none;align-items:center;min-height:44px;padding:0 18px;border-radius:12px;border:1.5px solid #FFB03A;color:var(--sl-color-white);font-weight:700;text-decoration:none;transition:transform .3s}
  .dh-get:hover{transform:translateY(-2px)}
  @keyframes dh-pop{from{transform:scale(.6) rotate(-30deg);opacity:0}to{transform:none;opacity:1}}
  @media (max-width:72rem){.dh-nav{display:none}}
  @media (max-width:84rem){.dh-nav{gap:1.1rem;font-size:.95rem}}
  @media (max-width:50rem){.dh-ver,.dh-get{display:none}.dh{padding-inline-end:3rem}}
  @media (prefers-reduced-motion:reduce){.dh-tgl svg{animation:none}}
</style>
