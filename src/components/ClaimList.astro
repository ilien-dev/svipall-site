---
/*
 * ClaimList — why any of this can be believed. C2 section 6.
 *
 * Each claim carries where to check it. That is the whole point of the band:
 * there is no social proof anywhere on this site, so the only thing holding it
 * up is that every claim is followed to something a reader can open.
 */

interface Claim {
  title: string;
  body: string;
  link?: { label: string; href: string };
}

interface Props {
  claims: Claim[];
}

const { claims } = Astro.props;
---

<ul class="claims">
  {
    claims.map((claim) => (
      <li class="claim">
        <h3 class="claim__title">{claim.title}</h3>
        <p class="claim__body">{claim.body}</p>
        {claim.link && (
          <p class="claim__link">
            <a href={claim.link.href}>{claim.link.label}</a>
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  /* The seams are the 1px gaps in the grid, showing the container's own
     background. Drawing them with per-child borders needs nth-child rules
     that only hold for one item count, and this list has seven. */
  .claims {
    margin: 0;
    display: grid;
    gap: var(--border-hair);
    padding: var(--border-hair);
    background: var(--color-hairline);
  }

  .claim {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-cell);
    min-width: 0;
  }

  .claim__title {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
    /* ptah-allow: measure - a heading, not body copy. The 45-75ch window is a
       body measure; ragging a heading tighter is the point of setting it. */
    max-width: 26ch; /* ptah-allow: measure */
  }

  .claim__body {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .claim__link {
    margin-top: auto;
    padding-top: var(--space-2);
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .claims {
    /* ONE COLUMN, not N-up. A grid of equal bordered blocks each holding a
       heading and a paragraph is a card wall, whatever the CSS calls it, and
       DIRECTION.md's component list rules one out by name. The idiom is a
       RULED BOARD: rows that share edges, with the label in a left column and
       the reading in a right one, which is the same shape section 2 uses and
       the same shape the brief's own reference used. */
      grid-template-columns: minmax(0, 1fr);
    }

    .claim {
      /* base.css caps every <li> at the reading measure, and these rows are
         list items. Under the old three-up grid each column sat below the cap
         so nothing showed; across the full rail the cap held the row at 653px
         and the rest of the track showed the container's own background as a
         grey block. The MEASURE still applies to the text inside; it must not
         apply to the row that carries it. */
      max-width: none;
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: var(--space-3) var(--space-6);
      align-items: start;
    }

    .claim__title {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .claim__body {
      grid-column: 2;
      grid-row: 1;
    }

    .claim__link {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0;
    }

  }
</style>
