---
/*
 * AskList — things you can ask for, in the reader's own words. C2 section 5.
 *
 * The densest band on the page (E8: this is where the rhythm compresses).
 * Each ask is set in the mono face because it is something you type, not
 * something the page is telling you.
 *
 * THE MARK names the tool family the sentence exercises - read, crawl, table,
 * watch, merge, threshold, document - so seven lines of near-identical mono
 * stop being one texture. It replaces the ASCII quote that stood in the same
 * column: the quote said "someone is speaking", which every row here already
 * says, so it was the one thing in the column that carried no information.
 * Each family is a tool this product documents. A mark for an eighth kind of
 * ask does not exist, and would not be drawn before the ask did.
 */
import Glyph from './Glyph.astro';
import type { GlyphName } from '../lib/glyphs';

interface Ask {
  mark: GlyphName;
  text: string;
}

interface Props {
  asks: Ask[];
  note: string;
}

const { asks, note } = Astro.props;
---

<div class="asks">
  <ul class="asks__list">
    {
      asks.map((ask) => (
        <li class="asks__item">
          <Glyph name={ask.mark} class="asks__mark" />
          <span class="asks__text">{ask.text}</span>
        </li>
      ))
    }
  </ul>
  <p class="asks__note">{note}</p>
</div>

<style>
  .asks {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* The seams are the 1px gaps in the grid, showing the container's own
     background. Drawing them with per-child borders needs nth-child rules
     that only hold for one item count, and this list has seven. */
  .asks__list {
    margin: 0;
    display: grid;
    gap: var(--border-hair);
    padding: var(--border-hair);
    background: var(--color-hairline);
  }

  .asks__item {
    display: grid;
    grid-template-columns: var(--glyph-size) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    /* space-3 rows: this is the one band that compresses. */
    padding: var(--space-3) var(--space-4);
    background: var(--color-cell);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--color-ink);
    max-width: none;
  }

  /* Optically on the first line of the ask beside it. The mono line box is
     taller than the mark, so centring the column would float it. */
  /* :global - the class is passed as a prop into Glyph, so it carries Glyph's
     scope hash and a plain rule here would match nothing. */
  :global(.asks__mark) {
    margin-top: 0.15em;
  }

  .asks__note {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  @media (min-width: 900px) {
    .asks__list {
      grid-template-columns: 1fr 1fr;
    }

    /* An odd count leaves the last slot empty, and an empty slot in this grid
       is a hole showing the container's own background as a solid block. The
       last item takes the whole row instead, so the count can change without
       the layout breaking. */
    .asks__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>
