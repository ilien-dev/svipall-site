---
/*
 * The one header of the site, on the product page and in the docs alike:
 * same mark, links, search, GitHub link, theme switch and "Get it free",
 * at the same size and place. Its colours are its own tokens, so it does not
 * depend on Starlight's palette or the product page's.
 *
 * `home` keeps the links in-page on the product page (no reload, they
 * scroll). `current` marks the section the reader is in. The search pill
 * opens Starlight's search in the docs (DocsHeader wires `data-open-search`)
 * and leads to it from the product page (`/docs/?search`, opened by the
 * router, which also runs the theme switch on both pages).
 */
interface Props {
  home?: boolean;
  current?: 'docs';
}
const { home = false, current } = Astro.props;
const at = (hash: string) => (home ? hash : `/${hash}`);
---

<div class:list={['dh', { 'dh-wrap': home }]}>
  <a class="dh-brand" href={home ? '#top' : '/'} aria-label="Svipall home">
    <img class="dh-mark dh-dark" src="/brand/svipall-mark-dark.svg" alt="" width="34" height="34" />
    <img class="dh-mark dh-light" src="/brand/svipall-mark.svg" alt="" width="34" height="34" />
    <svg class="dh-word" viewBox="0 0 711 183" width="88" height="23" aria-hidden="true"><path fill="currentColor" transform="translate(-0.4 172.2)" d="M55 2.40L55 2.40Q39.80 2.40 29.60-3Q19.40-8.40 14.20-19.70Q9-31 8.40-49L8.40-49L39-53.60Q39.20-43.20 40.90-36.80Q42.60-30.40 45.70-27.60Q48.80-24.80 53.20-24.80L53.20-24.80Q58.80-24.80 60.50-28.60Q62.20-32.40 62.20-36.60L62.20-36.60Q62.20-46.60 57.40-53.50Q52.60-60.40 44.40-67.40L44.40-67.40L30.40-79.60Q21.20-87.40 14.90-97.30Q8.60-107.20 8.60-121.80L8.60-121.80Q8.60-142.40 20.80-153.30Q33-164.20 54-164.20L54-164.20Q67-164.20 74.90-159.80Q82.80-155.40 86.90-148.30Q91-141.20 92.50-133.30Q94-125.40 94.20-118.20L94.20-118.20L63.40-114.40Q63.20-121.60 62.50-126.90Q61.80-132.20 59.60-135.10Q57.40-138 52.80-138L52.80-138Q47.80-138 45.50-133.80Q43.20-129.60 43.20-125.40L43.20-125.40Q43.20-116.40 47.50-110.70Q51.80-105 58.80-98.80L58.80-98.80L72.20-87Q82.80-78 90.10-66.60Q97.40-55.20 97.40-38.40L97.40-38.40Q97.40-27 92.20-17.70Q87-8.40 77.50-3Q68 2.40 55 2.40ZM180.60 0L142.80 0L113.60-162L144.20-162L161.60-52L177.80-162L210.20-162L180.60 0ZM270.40 0L234.60 0L234.60-162L270.40-162L270.40 0ZM338.40 0L302.60 0L302.60-162L357-162Q371.60-162 381-156.50Q390.40-151 395-140.50Q399.60-130 399.60-115L399.60-115Q399.60-96.20 393.40-86.30Q387.20-76.40 376.60-72.60Q366-68.80 352.80-68.80L352.80-68.80L338.40-68.80L338.40 0ZM338.40-136.80L338.40-93.80L350.40-93.80Q357-93.80 360.40-96.20Q363.80-98.60 364.90-103.40Q366-108.20 366-115.60L366-115.60Q366-121.80 365.10-126.50Q364.20-131.20 360.80-134Q357.40-136.80 350.20-136.80L350.20-136.80L338.40-136.80ZM441.20 0L407.40 0L438-162L478.80-162L509 0L476 0L470.60-34.20L446.80-34.20L441.20 0ZM458.60-118.80L450-55.60L467.20-55.60L458.60-118.80ZM606.40 0L533.40 0L533.40-162L569.20-162L569.20-24.20L606.40-24.20L606.40 0ZM703 0L630 0L630-162L665.80-162L665.80-24.20L703-24.20L703 0Z"/></svg>
  </a>
  <nav class="dh-nav" aria-label="Main">
    <a href={at('#flow')}>How it works</a>
    <a href={at('#abilities')}>Abilities</a>
    <a href={at('#apps')}>Your AI apps</a>
    <span class="dh-sep" aria-hidden="true"></span>
    <a href="/docs/" class:list={['dh-page', { 'dh-on': current === 'docs' }]} aria-current={current === 'docs' ? 'true' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"></path><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"></path></svg>Docs</a>
  </nav>
  <div class="dh-right">
    <slot name="search" />
    {home
      ? <a class="dh-search" href="/docs/?search" data-search-link><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><span>Search</span><kbd>Ctrl K</kbd></a>
      : <button type="button" class="dh-search" data-open-search><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><span>Search</span><kbd>Ctrl K</kbd></button>}
    <div class="dh-tools">
      <a class="dh-gh" href="https://github.com/ilien-dev/svipall" aria-label="Svipall on GitHub" title="Svipall on GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg></a>
      <button type="button" class="dh-tgl" data-theme-toggle aria-label="Colour theme">
        <svg class="dh-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="dh-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="dh-sys" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>
      </button>
    </div>
    <a class="dh-get" href={at('#get')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>Get it free</a>
  </div>
</div>

<style is:global>
  .dh{
    --hd-ink:#EDEBE8;--hd-muted:#DEDBD7;--hd-line:rgba(237,235,232,.22);--hd-sf:#16161a;--hd-ac:#E5303A;--hd-ac-text:#FFA3A8;--hd-btn:#D3202F;
    display:flex;align-items:center;justify-content:space-between;gap:1.25rem;height:100%;
    font-family:'Urbanist',system-ui,-apple-system,'Segoe UI',sans-serif;font-size:16px;line-height:1.2;color:var(--hd-ink);
  }
  .dh,.dh *,.dh *::before,.dh *::after{box-sizing:border-box}
  :root[data-theme='light'] .dh{--hd-ink:#0D0D0F;--hd-muted:#3E3B38;--hd-line:rgba(13,13,15,.18);--hd-sf:#E7E3DF;--hd-ac-text:#B51A28}
  .dh a{text-decoration:none}
  .dh a.dh-brand{display:flex;align-items:center;gap:.75rem;color:var(--hd-ink);flex:none;border-radius:10px}

  /* The brand leads home: the mark leans in on hover, and a click gives it a
     small spin and bounce (the router adds .dh-pop and keeps this element
     across a page swap, so the motion is never cut). */
  .dh-mark,.dh-word{transition:transform .35s cubic-bezier(.2,.7,.2,1)}
  .dh a.dh-brand:hover .dh-mark{transform:rotate(-10deg) scale(1.08)}
  .dh a.dh-brand:hover .dh-word{transform:translateX(3px)}
  .dh a.dh-brand:active .dh-mark{transform:rotate(-10deg) scale(.92)}
  @keyframes dh-pop-mark{0%{transform:rotate(-10deg) scale(.9)}45%{transform:rotate(14deg) scale(1.14)}75%{transform:rotate(-4deg) scale(.98)}100%{transform:none}}
  @keyframes dh-pop-word{0%{transform:translateX(0)}40%{transform:translateX(6px)}70%{transform:translateX(-2px)}100%{transform:none}}
  .dh a.dh-brand.dh-pop .dh-mark{animation:dh-pop-mark .55s cubic-bezier(.2,.7,.2,1)}
  .dh a.dh-brand.dh-pop .dh-word{animation:dh-pop-word .55s cubic-bezier(.2,.7,.2,1)}

  /* Docs is another page, not a section of this one: set apart by a rule
     and carrying a book. */
  .dh-sep{align-self:center;width:1px;height:20px;margin:0 .35rem;background:var(--hd-line)}
  .dh .dh-nav a.dh-page{gap:.4rem}
  .dh .dh-nav a.dh-page svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s cubic-bezier(.2,.7,.2,1)}
  .dh .dh-nav a.dh-page:hover svg{transform:rotate(-8deg) translateY(-1px)}
  :root[data-theme='light'] .dh-dark,:root:not([data-theme='light']) .dh-light{display:none}

  /* The links: an underline grows from the centre and the text warms to the
     accent, so each one reads as something to click. */
  .dh-nav{display:flex;gap:.5rem}
  .dh .dh-nav a{position:relative;display:inline-flex;align-items:center;min-height:44px;padding:0 .7rem;border-radius:10px;color:var(--hd-ink);transition:color .25s,background-color .25s}
  .dh .dh-nav a::after{content:'';position:absolute;left:.7rem;right:.7rem;bottom:6px;height:2px;border-radius:2px;background:var(--hd-ac);transform:scaleX(0);transition:transform .3s cubic-bezier(.2,.7,.2,1)}
  .dh .dh-nav a:hover{color:var(--hd-ac-text);background-color:color-mix(in srgb,var(--hd-sf) 70%,transparent)}
  .dh .dh-nav a:hover::after,.dh .dh-nav a.dh-on::after{transform:scaleX(1)}
  .dh .dh-nav a.dh-on{color:var(--hd-ac-text)}
  .dh .dh-nav a:active{transform:translateY(1px)}

  .dh-right{display:flex;flex:none;align-items:center;gap:.75rem}
  /* Starlight's search element stays rendered: only its own button is hidden.
     Hiding the whole element hid its modal dialog too, and an open modal
     nobody can see leaves the page inert. */
  .dh-right site-search{display:contents}
  .dh-right site-search > button[data-open-modal]{display:none}
  .dh .dh-search{display:inline-flex;align-items:center;gap:.6rem;min-height:44px;padding:0 .9rem;border-radius:12px;border:1px solid var(--hd-line);background:var(--hd-sf);color:var(--hd-muted);font:inherit;font-size:.9rem;cursor:pointer;transition:border-color .25s,transform .25s}
  .dh .dh-search:hover{border-color:var(--hd-ac);transform:translateY(-2px)}
  .dh-search svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
  .dh .dh-search kbd{all:unset;font-size:.75rem;opacity:.85}
  /* GitHub and the theme switch are one joined pair: two tools, one shape. */
  .dh-tools{display:inline-flex;flex:none;border:1px solid var(--hd-line);border-radius:12px;overflow:hidden}
  .dh a.dh-gh{display:inline-flex;flex:none;align-items:center;justify-content:center;width:44px;height:42px;color:var(--hd-ink);border-right:1px solid var(--hd-line);transition:background-color .3s,color .3s}
  .dh a.dh-gh:hover{background:var(--hd-sf);color:var(--hd-ac-text)}
  .dh-gh svg{width:20px;height:20px;fill:currentColor;transition:transform .3s cubic-bezier(.2,.7,.2,1)}
  .dh a.dh-gh:hover svg{transform:translateY(-2px)}
  .dh-tgl{display:inline-flex;align-items:center;justify-content:center;width:44px;height:42px;border:0;background:transparent;color:var(--hd-ink);cursor:pointer;transition:transform .3s,background-color .3s}
  .dh-tgl:hover{background:var(--hd-sf)}.dh-tgl:hover svg{transform:rotate(-20deg)}
  .dh-tgl svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;animation:dh-pop .35s cubic-bezier(.2,.7,.2,1) both}
  /* The button shows the choice in force: light, dark, or the system's. */
  .dh-tgl svg{display:none}
  :root[data-theme-choice='light'] .dh-sun,:root[data-theme-choice='dark'] .dh-moon,:root:not([data-theme-choice='light']):not([data-theme-choice='dark']) .dh-sys{display:block}
  .dh a.dh-get{display:inline-flex;gap:.55rem;white-space:nowrap;flex:none;align-items:center;min-height:44px;padding:0 18px;border-radius:12px;border:1.5px solid var(--hd-btn);background:var(--hd-btn);color:#fff;font-weight:700;position:relative;overflow:hidden;transition:transform .3s,background-color .3s,color .3s}
  .dh-get svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .dh a.dh-get:hover{transform:translateY(-2px);box-shadow:0 12px 26px -12px rgba(229,48,58,.7)}
  /* A light sweeps across the button, a loop that moves only transform. */
  .dh a.dh-get::after{content:'';position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);transform:translateX(-120%) skewX(-20deg);animation:dh-sheen 4.5s cubic-bezier(.65,0,.35,1) infinite}
  @keyframes dh-sheen{0%{transform:translateX(-120%) skewX(-20deg)}55%,100%{transform:translateX(320%) skewX(-20deg)}}
  .dh :focus-visible{outline:3px solid var(--hd-ac);outline-offset:3px}

  @keyframes dh-pop{from{transform:scale(.6) rotate(-30deg);opacity:0}to{transform:none;opacity:1}}
  @keyframes hdr-in{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:none}}
  html:not(.vt) .dh{animation:hdr-in .6s cubic-bezier(.2,.7,.2,1) both}

  @media (max-width:84rem){.dh-nav{gap:0}.dh .dh-nav a{padding:0 .5rem;font-size:.95rem}.dh .dh-nav a::after{left:.5rem;right:.5rem}.dh-sep{margin:0 .2rem}}
  /* Narrow: the docs have their menu; the product page keeps its links on a second row. */
  @media (max-width:72rem){.dh .dh-nav{display:none}.dh-wrap{flex-wrap:wrap;row-gap:.25rem}.dh-wrap.dh .dh-nav{display:flex;white-space:nowrap;scrollbar-width:none;order:3;width:100%;overflow-x:auto;margin-inline:-.5rem}}
  @media (max-width:62rem){.dh .dh-search span,.dh .dh-search kbd{display:none}.dh .dh-search{width:44px;padding:0;justify-content:center}}
  @media (max-width:50rem){.dh a.dh-get{display:none}}
  @media (max-width:26rem){.dh{gap:.5rem}.dh-right{gap:.5rem}}
  @media (prefers-reduced-motion:reduce){.dh,.dh *,.dh-tgl svg{animation:none!important}.dh a.dh-brand:hover *{transform:none}.dh *{transition:none!important}}
</style>
