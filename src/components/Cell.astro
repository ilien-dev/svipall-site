---
/*
 * Cell — a bordered box inside a Row. The unit the grid is made of.
 *
 * It has a drawn edge on all four sides and a fill, because in this idiom an
 * object is defined by its edge. It never has a radius, never a shadow, and
 * never contains another Cell: a cell inside a cell puts two rules at one
 * corner, which this grid does not do.
 *
 * `label` puts a mono caption in the cell's top-left, on its own ruled line,
 * so a group of cells reads as a table of the same kind of thing.
 */

interface Props {
  label?: string;
  fill?: 'cell' | 'accent';
  class?: string;
}

const { label, fill = 'cell', class: className = '' } = Astro.props;
---

<div class={`cell cell--${fill} ${className}`}>
  {
    label && (
      <p class="cell__label">
        <span>{label}</span>
      </p>
    )
  }
  <div class="cell__body">
    <slot />
  </div>
</div>

<style>
  .cell {
    display: flex;
    flex-direction: column;
    border: var(--border-hair) solid var(--color-hairline);
    border-radius: var(--radius-0);
    min-width: 0;
  }

  .cell--cell {
    background: var(--color-cell);
    color: var(--color-ink);
  }

  /* The accent is fill only, and this is the fill. R-G3-14. */
  .cell--accent {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-accent);
  }

  .cell__label {
    margin: 0;
    max-width: none;
    padding: var(--space-2) var(--space-4);
    border-bottom: var(--border-hair) solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: var(--leading-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .cell--accent .cell__label {
    border-bottom-color: var(--color-on-accent);
    color: var(--color-on-accent);
  }

  .cell__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }
</style>
