---
/*
 * InstallBlock — the primary CTA. C5, A5.
 *
 * Two real install paths, so a switch rather than a label. Both are documented
 * in the product README: the pasteable prompt any agent can follow, and the
 * Claude Code plugin commands. Neither is invented and neither is a variant of
 * the other, which is what earns a control here instead of one default and a
 * link to the rest.
 *
 * The switch is a tab set, which the component vocabulary refused. It is added
 * to the vocabulary with this reason rather than smuggled in: R-G3-10.
 *
 * The active tab is marked with ink and a rule, not with the accent. The
 * accent is fill only and exactly one accent fill on this page is a control:
 * the copy button. A highlighted tab would be a second one.
 *
 * ITS FRAME IS SEE-THROUGH, at the author's direction, and it is the second
 * cell on this site to be - the hero terminal is the other. Same treatment
 * for the same reason: it sits on the hero film, and opaque it was a slab in
 * the middle of the picture. --color-cell-film and --blur-frost, both from
 * the token layer, so the two cells cannot drift apart.
 * What does NOT become see-through is the copy control. It is the one accent
 * fill on the page and the one thing here that is pressed; a translucent
 * button is a button you have to look twice at. It stays solid on top of a
 * frame you can see through, which is also what tells them apart.
 */

/*
 * A command is written as tokens so its parts can carry different weight.
 * The accent does not appear in here at all. It used to highlight the URL and
 * the repository slug, which put two amber masses beside a third - the copy
 * control - and the eye had no way to tell which of the three was the thing to
 * press. Structure is carried by weight and value instead, which is what the
 * `cmd` / `sub` / `key` tokens are for; the one accent fill in the block is the
 * control.
 */
interface Token {
  text: string;
  kind?: 'cmd' | 'sub' | 'key';
}

interface Variant {
  id: string;
  tab: string;
  label: string;
  /* 'prompt' draws a UI glyph in currentColor. Any other value is a slug in
     src/assets/clients, drawn in the brand's own colour: recolouring someone
     else's mark is worse than showing it as it is. A tab mark is a single
     currentColor shape - a two-colour mark is knocked out of itself, never
     painted with a second value from this palette. */
  icon?: 'prompt' | string;
  iconColor?: string;
  lead?: string;
  url?: string;
  lines?: Token[][];
}

interface Props {
  id: string;
  variants: Variant[];
  /* The version of the thing this block installs, under the frame. Off by
     default and on once per page: the hero block and the closing block are
     the same command, and the same fact stated twice on one page stops being
     a fact and becomes decoration. The nav carries it everywhere else. */
  release?: boolean;
}

import fs from 'node:fs';
import { lucideBody } from '../lib/lucide';
import path from 'node:path';
import Release from './Release.astro';

const { id, variants, release = false } = Astro.props;

// Every slash is a break opportunity and nothing else is. The segments keep
// their trailing slash; the template puts a <wbr> between them. <wbr> carries
// no text, so the copy button reads the same string it always did.
function urlSegments(url: string): string[] {
  const parts = url.split('/');
  return parts.map((part, i) => (i === parts.length - 1 ? part : part + '/'));
}

// Built here rather than inline: a multi-line expression inside a <pre> is
// where the compiler gives up, and a newline written in markup is whitespace
// the parser is free to reinterpret.
const NEWLINE = '\n';
const iconSvg = (slug: string) =>
  fs
    .readFileSync(path.resolve(`src/assets/clients/${slug}.svg`), 'utf8')
    .replace(/<title>[\s\S]*?<\/title>/g, '')
    .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');

const rows = variants.map((variant) => ({
  ...variant,
  markSvg:
    variant.icon && variant.icon !== 'prompt' ? iconSvg(variant.icon) : null,
  // What is copied is the plain command, whatever the tokens are styled as.
  code:
    variant.lead ??
    (variant.lines ?? [])
      .map((line) => line.map((token) => token.text).join(' '))
      .join(NEWLINE),
}));
---

<div class="install">
  <div class="install__frame">
    <div class="install__tabs" role="tablist" aria-label="How to install">
      <span class="install__marker" aria-hidden="true" data-install-marker></span>
      {
        rows.map((variant, i) => (
          <button
            class="install__tab"
            type="button"
            role="tab"
            id={`${id}-tab-${variant.id}`}
            aria-controls={`${id}-panel-${variant.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-install-tab={variant.id}
          >
            {variant.icon === 'prompt' && (
              <svg
                class="install__tabicon"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
                set:html={lucideBody('terminal')}
              />
            )}
            {variant.markSvg && (
              <span
                class="install__tabicon install__tabicon--brand"
                style={`color: ${variant.iconColor}`}
                set:html={variant.markSvg}
              />
            )}
            {variant.tab}
          </button>
        ))
      }
    </div>

    <div class="install__panels">
    {
      rows.map((variant, i) => (
        <div
          class={`install__panel ${i === 0 ? 'is-current' : ''}`}
          role="tabpanel"
          id={`${id}-panel-${variant.id}`}
          aria-labelledby={`${id}-tab-${variant.id}`}
          data-install-panel={variant.id}
        >
          <div class="install__row">
            {variant.lead ? (
              <pre class="install__code" id={`${id}-code-${variant.id}`}>{variant.lead}{NEWLINE}<span class="install__url">{
                  /* Break after a slash and nowhere else. With overflow-wrap
                     alone the URL broke mid-token - ".../ilien-" then "-dev/"
                     in one block and ".../ilie" then "n-dev/" in the other -
                     which reads as a typo on the one string this page exists
                     to have copied. */
                  urlSegments(variant.url ?? '').map((seg, i, all) => (
                    <Fragment><span class="install__seg">{seg}</span>{i < all.length - 1 && <wbr />}</Fragment>
                  ))
                }</span></pre>
            ) : (
              <pre class="install__code" id={`${id}-code-${variant.id}`}>{
                (variant.lines ?? []).map((line, n) => (
                  <span class="install__cmdline">{
                    line.map((token, t) => (
                      <span class={`install__tok install__tok--${token.kind ?? 'sub'}`}>{
                        token.text
                      }{t < line.length - 1 ? ' ' : ''}</span>
                    ))
                  }{n < (variant.lines ?? []).length - 1 ? NEWLINE : ''}</span>
                ))
              }</pre>
            )}

            <button
              class="install__copy"
              type="button"
              data-copy-target={`${id}-code-${variant.id}`}
              aria-describedby={`${id}-tab-${variant.id}`}
            >
              <svg
                class="install__glyph"
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
                set:html={lucideBody('copy')}
              />
              <span class="visually-hidden install__copy-idle">
                Copy {variant.label}
              </span>
              <span class="visually-hidden install__copy-done" hidden>Copied</span>
              <svg
                class="install__tick"
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
                hidden
                set:html={lucideBody('check')}
              />
            </button>
          </div>
        </div>
      ))
    }
    </div>
  </div>

  {release && <Release variant="line" />}
</div>

<style>
  .install {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .install__frame {
    border: var(--border-hair) solid var(--color-hairline);
    /* See-through over the hero film. See the header. */
    background: var(--color-cell-film);
    -webkit-backdrop-filter: blur(var(--blur-frost));
    backdrop-filter: blur(var(--blur-frost));
  }

  .install__tabs {
    position: relative;
    display: flex;
    border-bottom: var(--border-hair) solid var(--color-hairline);
  }

  /* A filled bar rather than a border, because a bar can be moved with
     transform alone: animating width or left would animate layout and force a
     reflow every frame.
     Ink, not accent. It was tried in amber and taken back: the accent is fill
     only and exactly one accent fill on the page is a control, which is the
     copy button. Marking the active tab in ink keeps that true. */
  .install__marker {
    position: absolute;
    left: 0;
    bottom: calc(var(--border-hair) * -1);
    width: 100%;
    height: 3px;
    background: var(--color-ink);
    transform-origin: left center;
    transform: translateX(var(--marker-x, 0)) scaleX(var(--marker-s, 0));
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .install__tab {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: var(--leading-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: color var(--dur-state) var(--ease-out);
  }

  .install__tab + .install__tab {
    border-left: var(--border-hair) solid var(--color-hairline);
  }

  .install__tab:hover {
    color: var(--color-ink);
  }

  .install__tab[aria-selected='true'] {
    color: var(--color-ink);
  }

  /* Every panel occupies the same cell of a one-cell grid, so the frame is
     always as tall as the tallest option and the switch does not make the
     page jump. visibility:hidden also takes the inactive panel out of the
     accessibility tree and out of the tab order, which the hidden attribute
     was doing before. */
  .install__panels {
    display: grid;
  }

  /* The two panels share one grid cell, so they cross-fade in place. The
     visibility flip is delayed by the fade so the outgoing panel is still
     painted while it leaves, and is gone from the accessibility tree and the
     tab order the moment it finishes. */
  /* ptah-allow: rest-opacity-zero - the first panel ships with .is-current in
     the HTML, not applied by script, so the served page shows it with no
     JavaScript at all. Verified in dist/index.html. */
  .install__panel {
    grid-area: 1 / 1;
    opacity: 0; /* ptah-allow: rest-opacity-zero */
    visibility: hidden;
    transition:
      opacity var(--dur-reveal) var(--ease-out),
      visibility 0s linear var(--dur-reveal);
  }

  .install__panel.is-current {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-reveal) var(--ease-out),
      visibility 0s;
  }

  .install__tabicon {
    flex: none;
    display: block;
  }

  /* lucide ships a 2px round line sized for a 24-unit box. Stripped here the
     same way Glyph.astro strips it, so a tab mark is drawn with a device-pixel
     line and not with the set's own weight. Slightly heavier than --glyph-stroke
     on purpose: this sits at 14px beside 10px uppercase mono, under the smallest
     type on the page.

     Scoped away from the brand mark. That one is a filled shape with a mask
     inside it, and a blanket `fill: none` reaches into the mask and empties
     it - the mark then renders as nothing at all. */
  .install__tabicon:not(.install__tabicon--brand) :global(*) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* A brand mark keeps its own colour. It is decoration beside a text label
     that already says which tab this is, so it carries no contrast duty.

     The rule above used to set `fill: none` on every descendant, so the `fill`
     written on the <svg> never reached the <path>: the mark was being STROKED
     at 1.4px in coral, which is why twenty tapered rays read as a smudge and
     not as a sunburst. It is scoped to the lucide glyph now.

     The Claude Code tab draws `claudecode-tile`, not `claudecode`: the tile
     the vendor publishes, with the sunburst knocked out of it. The bare
     sunburst has no mass of its own - its rays go sub-pixel below about 20px -
     and at this size mass is the whole job. The knockout is a hole, not a
     painted ray, so it shows whatever is behind the tab and needs no second
     colour and no theme of its own. The belt in Clients.astro keeps the bare
     mark: there it is 30px, in ink, in a row of other bare silhouettes. */
  .install__tabicon--brand :global(svg) {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* The panel fills its grid cell and the row fills the panel, so the copy
     control is the full height of the frame on both tabs rather than the
     height of whichever command happens to be shorter. */
  .install__panel {
    display: flex;
  }

  .install__row {
    display: flex;
    align-items: stretch;
    flex: 1 1 auto;
  }

  .install__code {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    white-space: pre-wrap;
    /* Break the URL where it has to, not mid-word wherever it lands. */
    /* break-word, not anywhere: it may only break a token that cannot fit on
       a line of its own, so the <wbr> offers above are taken first. */
    overflow-wrap: break-word;
  }

  /* Each run between two slashes is unbreakable, which leaves the <wbr> after
     every slash as the ONLY place the URL may break. Without it the browser
     was free to break at the hyphen inside "ilien-dev" whenever that filled
     the line better - and it did, in the hero, whose cell is narrower than
     band 8's, so the same string broke two different ways on one page. A span
     carries no text, so the copy button still yields the URL exactly. */
  .install__seg {
    white-space: nowrap;
  }

  /* Structure by weight and value, so the shape of a command reads without
     spending the accent on every part of it. */
  .install__tok--cmd {
    color: var(--color-ink);
    font-weight: 700;
  }

  .install__tok--sub {
    color: var(--color-ink-muted);
  }

  .install__tok--key,
  .install__url {
    color: var(--color-ink);
    font-weight: 700;
  }

  .install__copy {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    /* Hit target: 44px minimum on touch. Craft floor.
       88, not 128. The width was inflated to out-mass the accent highlight
       behind the URL; with that highlight gone this is the only accent fill in
       the block, and at 128 against a three-line panel it stretched into a
       slab the size of the code beside it. */
    min-height: 44px;
    min-width: 88px;
    padding: var(--space-3) var(--space-4);
    border-left: var(--border-hair) solid var(--color-hairline);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-0);
    transition: opacity var(--dur-state) var(--ease-out);
  }

  .install__copy:hover {
    opacity: 0.88;
  }

  .install__glyph,
  .install__tick {
    flex: none;
    /* The word came off the button, so the glyph carries the whole affordance
       on its own. At 16px it read as a decoration. */
    width: 22px;
    height: 22px;
  }

  /* Heavier than --glyph-stroke because this one is not a mark beside a
     sentence: it is the whole affordance of the only accent-filled control on
     the page, reversed out of that fill. A hairline on --color-on-accent
     disappeared into it. */
  .install__glyph :global(*),
  .install__tick :global(*) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    vector-effect: non-scaling-stroke;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* The UA sheet's [hidden] rule is namespaced to HTML and does not reach an
     inline SVG. Without this the copy mark and the tick would both be painted
     the moment the button is pressed. */
  .install__glyph[hidden],
  .install__tick[hidden] {
    display: none;
  }

  /* Below this the button stops fitting beside wrapped lines of URL and goes
     under them rather than squeezing the code to nothing. */
  @media (max-width: 520px) {
    .install__row {
      flex-direction: column;
    }

    .install__copy {
      width: 100%;
      border-left: 0;
      border-top: var(--border-hair) solid var(--color-hairline);
    }
  }
</style>

<script>
  // --- the switch ---------------------------------------------------------
  for (const frame of document.querySelectorAll<HTMLElement>('.install__frame')) {
    const tabs = Array.from(frame.querySelectorAll<HTMLElement>('[data-install-tab]'));
    const panels = Array.from(
      frame.querySelectorAll<HTMLElement>('[data-install-panel]')
    );
    if (tabs.length < 2) continue;

    const marker = frame.querySelector<HTMLElement>('[data-install-marker]');
    const tablist = frame.querySelector<HTMLElement>('.install__tabs');

    const placeMarker = () => {
      if (!marker || !tablist) return;
      const active = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (!active) return;
      const total = tablist.getBoundingClientRect().width;
      if (!total) return;
      marker.style.setProperty('--marker-x', `${active.offsetLeft}px`);
      marker.style.setProperty(
        '--marker-s',
        String(active.getBoundingClientRect().width / total)
      );
    };

    const select = (name: string, focus = false) => {
      for (const tab of tabs) {
        const on = tab.dataset.installTab === name;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      }
      for (const panel of panels) {
        panel.classList.toggle('is-current', panel.dataset.installPanel === name);
      }
      placeMarker();
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab.dataset.installTab ?? ''));
    }

    placeMarker();
    // The bar is positioned from measured widths, so it has to be replaced
    // when those widths change.
    window.addEventListener('resize', placeMarker);
    if (document.fonts?.ready) document.fonts.ready.then(placeMarker);

    // Arrow keys, because a tablist that only answers the mouse is a row of
    // buttons wearing tab roles.
    frame.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key !== 'ArrowLeft' && key !== 'ArrowRight') return;
      const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const next = (current + (key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      select(tabs[next].dataset.installTab ?? '', true);
      event.preventDefault();
    });
  }

  // --- copy ---------------------------------------------------------------
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>(
      '[data-copy-target]'
    );
    if (!button) return;

    const source = document.getElementById(button.dataset.copyTarget ?? '');
    if (!source?.textContent) return;

    try {
      await navigator.clipboard.writeText(source.textContent);
    } catch {
      // Clipboard refused, usually an insecure context. Say nothing false:
      // select the text so the reader can copy it themselves.
      const range = document.createRange();
      range.selectNodeContents(source);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      return;
    }

    const idle = button.querySelector<HTMLElement>('.install__copy-idle');
    const done = button.querySelector<HTMLElement>('.install__copy-done');
    const glyph = button.querySelector<SVGElement>('.install__glyph');
    const tick = button.querySelector<SVGElement>('.install__tick');
    if (!idle || !done) return;

    /* setAttribute, not .hidden. Both marks are SVG elements now and
       SVGElement does not implement the hidden IDL attribute - assigning it
       sets a property nothing renders from, and both marks would show at
       once. The [hidden] rule in this component's styles is the other half:
       the UA sheet's own [hidden] rule is namespaced to HTML. */
    const show = (el: Element | null, on: boolean) => {
      if (!el) return;
      if (on) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    };

    idle.hidden = true;
    done.hidden = false;
    show(glyph, false);
    show(tick, true);

    window.setTimeout(() => {
      idle.hidden = false;
      done.hidden = true;
      show(glyph, true);
      show(tick, false);
    }, 2000);
  });
</script>
