---
/*
 * The docs shell. A READ surface, not a persuade one: it inherits the ledger
 * and the tokens, and changes register and density rather than idiom.
 *
 * The cell grid holds. The sidebar, the prose and the on-this-page list are
 * three cells of one ruled board, divided by the same hairlines as the home,
 * and the rail's vertical rules continue the lines the nav already draws.
 *
 * Taken from the Stripe reference recorded in D-REF: a persistent left rail,
 * and a right-hand column that stays put while the prose scrolls.
 */
import Base from './Base.astro';
import Glyph from '../components/Glyph.astro';
import { docsNav, GROUP_MARKS } from '../lib/docs-nav';
import Search from '../components/Search.astro';
import '../styles/prose.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  summary: string;
  source: string;
  slug: string;
  headings?: Heading[];
}

const { title, summary, source, slug, headings = [] } = Astro.props;

const nav = await docsNav();

// Only h2 and h3. A list that mirrors every heading depth stops being a map
// and becomes the document again.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const repo = 'https://github.com/ilien-dev/svipall/blob/main/';
---

<Base title={`${title} — Svipall docs`} description={summary}>
  <div class="docs">
    <div class="docs__rail">
      <aside class="docs__side">
        <div class="side">
          <Search />

          <nav class="side__nav" aria-label="Documentation">
          {
            nav.map((group) => (
              <div class="side__group">
                <p class="side__heading">
                  <Glyph name={GROUP_MARKS[group.name]} class="side__mark" />
                  {group.name}
                </p>
                <ul>
                  {group.pages.map((page) => (
                    <li>
                      <a
                        class="side__link"
                        href={`/docs/${page.id}`}
                        aria-current={page.id === slug ? 'page' : undefined}
                      >
                        {page.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          </nav>
        </div>
      </aside>

      <article class="docs__main">
        <header class="docs__head">
          <h1>{title}</h1>
          <p class="docs__summary">{summary}</p>
        </header>

        <div class="prose" data-pagefind-body>
          <slot />
        </div>

        <footer class="docs__foot">
          <p>
            <Glyph name="sourcefile" class="docs__footmark" />
            Written from <a href={`${repo}${source}`}><code>{source}</code></a> in
            the product repository. Where this page and that file disagree, the
            file is right: it ships with the code and this does not.
          </p>
        </footer>
      </article>

      <nav class="docs__toc" aria-label="On this page">
        {
          toc.length > 0 && (
            <div class="toc">
              <p class="toc__heading">On this page</p>
              <ul>
                {toc.map((h) => (
                  <li class={`toc__item toc__item--${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </nav>
    </div>
  </div>
</Base>

<style>
  /* Density: compact. The home is comfortable; the docs are a reference and
     a reference that spaces like a landing page wastes the reader's scroll. */
  .docs {
    --measure: var(--measure-docs);
    font-size: var(--text-xs);
  }

  .docs__rail {
    display: grid;
    grid-template-columns: var(--docs-sidebar) minmax(0, 1fr) var(--docs-toc);
    width: 100%;
    max-width: var(--rail);
    margin-inline: auto;
    /* The seams are the 1px gaps, showing the container's own background,
       the same technique the home's lists use. */
    gap: var(--border-hair);
    background: var(--color-hairline);
    border-inline: var(--border-hair) solid var(--color-hairline);
  }

  .docs__side,
  .docs__main,
  .docs__toc {
    background: var(--color-ground);
  }

  /* --- sidebar ---------------------------------------------------------- */

  .docs__side {
    padding: var(--space-6) var(--space-4);
  }

  .side {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-5));
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    /* The scroll belongs to the list, NOT to this element. The search results
       are absolutely positioned inside it, and an overflow: auto ancestor
       clips an absolute child - the panel would open and be cut off at the
       first line. */
    max-height: calc(100svh - var(--nav-height) - var(--space-8));
  }

  .side__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 0;
    /* Still scrolls rather than trapping the page on a very short window, but
       the list is now short enough that it rarely has to - and when it does the
       bar is drawn from the palette instead of the operating system's, because
       every other separator on this surface is a drawn hairline. */
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-hairline) transparent;
  }

  /* In the line with the label, not above it. R-G3-10 refuses the icon tile
     and a mark stacked over a heading is one however it is drawn. */
  .side__heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-1);
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* Tightened so the whole list fits the sticky column without an inner
     scroll. It was 8px of padding a side, which pushed the twelve links plus
     four group labels past a 648px viewport; the column then grew its own
     scrollbar and hid four pages and a whole group label behind it. The rows
     keep the 24px target as a min-height rather than as padding. */
  .side__link {
    display: flex;
    align-items: center;
    min-height: var(--hit-min);
    padding: var(--space-1) var(--space-3);
    color: var(--color-ink-muted);
    text-decoration: none;
    /* The marker is a drawn edge, not a fill: the accent is spent on the
       home's one control and on marks, and a sidebar of accent bars would
       make every page look like the call to action. R-G3-05. */
    border-left: var(--border-hair) solid transparent;
    transition:
      color var(--dur-state) var(--ease-out),
      border-color var(--dur-state) var(--ease-out);
  }

  .side__link:hover {
    color: var(--color-ink);
    border-left-color: var(--color-hairline);
  }

  .side__link[aria-current='page'] {
    color: var(--color-ink);
    border-left-color: var(--color-ink);
    background: var(--color-cell);
  }

  /* --- the page --------------------------------------------------------- */

  .docs__main {
    min-width: 0;
    padding: var(--space-7) var(--space-6) var(--space-8);
  }

  .docs__head {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: var(--border-hair) solid var(--color-hairline);
  }


  .docs__head h1 {
    font-size: var(--text-xl);
  }

  .docs__summary {
    margin-top: var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* Floated into the first line of the paragraph rather than given a column:
     this is one sentence of provenance, not a row of a ruled board. */
  :global(.docs__footmark) {
    display: inline-block;
    vertical-align: -0.15em;
    margin-right: 0.5em;
  }

  .docs__foot {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: var(--border-hair) solid var(--color-hairline);
    color: var(--color-ink-muted);
    font-size: var(--text-2xs);
  }

  /* --- on this page ----------------------------------------------------- */

  .docs__toc {
    padding: var(--space-7) var(--space-4);
  }

  .toc {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-5));
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .toc__heading {
    margin: 0 0 var(--space-1);
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .toc a {
    display: block;
    /* One pixel short of the target minimum without this: the label is 15px
       and 4px of padding either side reaches 23. */
    min-height: var(--hit-min);
    padding-block: var(--space-1);
    padding-left: var(--space-3);
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
    /* The marker rail. Transparent until a section is current, so the text
       never shifts sideways when it becomes so. */
    border-left: var(--border-hair) solid transparent;
    transition:
      color var(--dur-state) var(--ease-out),
      border-color var(--dur-state) var(--ease-out);
  }

  .toc a:hover {
    border-left-color: var(--color-hairline);
  }

  /* Depth carried by weight as well as indent. It was one grey at one size
     with nesting shown by indent alone, which made the whole rail read as a
     paragraph rather than a map: a sub-heading was visually identical to its
     parent. The top level is ink, the level below it is muted. */
  .toc__item--3 a {
    padding-left: var(--space-5);
    color: var(--color-ink-quiet);
  }

  /* Where the reader actually is, marked with the same left rule the sidebar
     uses for the current page, so one device means one thing on this surface. */
  .toc a[aria-current='true'] {
    border-left-color: var(--color-ink);
    background: var(--color-cell);
  }

  /* --- narrow ------------------------------------------------------------ */

  /* The on-this-page list goes first, because it is the one column that stops
     being useful when it is not beside the prose. The sidebar stays: it is
     how a reader moves between pages, and hiding it behind a control they
     have to find is worse than a list they can scroll past. */
  @media (max-width: 1180px) {
    .docs__rail {
      grid-template-columns: var(--docs-sidebar) minmax(0, 1fr);
    }

    .docs__toc {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .docs__rail {
      grid-template-columns: minmax(0, 1fr);
      border-inline: 0;
    }

    .side {
      position: static;
      max-height: none;
      overflow: visible;
    }

    .side__nav {
      overflow: visible;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-5);
    }

    .docs__main {
      padding: var(--space-6) var(--space-4) var(--space-7);
    }
  }
</style>

<script>
  /* Marks the section the reader is actually in. The on-this-page rail said
     what the page contains but never where you were in it - which is the one
     question the criterion is about, since most readers arrive halfway down
     from a search result rather than at the top.

     REST STATE: with no JavaScript nothing is marked, which is the same list
     it was before. Nothing is hidden waiting for this to run. */
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.toc a')) {
    const id = decodeURIComponent(a.hash.slice(1));
    if (id) links.set(id, a);
  }

  if (links.size > 0) {
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let current = '';
    const mark = () => {
      // The last heading whose top has passed the reading line. Picking the
      // topmost intersecting entry instead would jump back up whenever a long
      // section scrolled past a short one.
      const line = window.innerHeight * 0.3;
      let found = '';
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= line) found = h.id;
      }
      if (found === current) return;
      links.get(current)?.removeAttribute('aria-current');
      links.get(found)?.setAttribute('aria-current', 'true');
      current = found;
    };

    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          mark();
          ticking = false;
        });
      },
      { passive: true }
    );
    mark();
  }
</script>
