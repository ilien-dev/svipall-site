---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/tokens.css';
import '../styles/base.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Mark from '../components/Mark.astro';
import Glyph from '../components/Glyph.astro';
import MakerMark from '../components/MakerMark.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/* Inlined, not <img src>: an SVG in an <img> is a separate document and cannot
   see currentColor or this page's custom properties. That has been shipped
   wrong here twice already. Filled rather than stroked, so it does not go
   through Glyph.astro, whose whole job is to redraw a stroke. */
const githubSvg = fs
  .readFileSync(path.resolve('src/assets/github.svg'), 'utf8')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ')
  .trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/archivo-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/commitmono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      // Runs before first paint: a stored choice must not arrive after the
      // wrong theme has already been drawn.
      (() => {
        try {
          const stored = localStorage.getItem('svipall-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          // Site data blocked. The system preference decides, which is fine.
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="nav__rail">
        <a class="nav__home" href="/">
          <Mark size={60} />
          <span>Svipall</span>
        </a>

        <nav class="nav__links" aria-label="Main">
          <a href="/docs"><Glyph name="docs" /><span>Docs</span></a>
          <a
            class="nav__icon"
            href="https://github.com/ilien-dev/svipall"
            aria-label="Source on GitHub"
            title="Source on GitHub"
            set:html={githubSvg}
          />
        </nav>

        <ThemeToggle />
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    {/* The maker's signature, on every page. The lockup and the domain are
        one link and "That person is" is not: a signature and the address it
        signs are one destination, the sentence introducing them is a
        sentence. The lockup is aria-hidden because it is a drawing of a word,
        so the word goes back into the link's text for screen readers. */}
    <footer class="foot">
      <div class="foot__rail">
        <p>Svipall is built in the open, by one person.</p>
        <p class="foot__credit">
          That person is <a class="foot__maker" href="https://ilien.dev">
            <MakerMark />
            <span class="visually-hidden">ilien</span>
            <span class="foot__domain">— ilien.dev</span>
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: var(--z-toast);
    padding: var(--space-3) var(--space-4);
    background: var(--color-cell);
    border: var(--border-hair) solid var(--color-hairline);
    text-decoration: none;
    /* Parked off-screen with a transform, not with `top`. Animating `top` is
       animating a layout property, which forces a reflow on every frame of
       the one movement a keyboard user sees first. */
    transform: translateY(calc(-100% - var(--space-6)));
    transition: transform var(--dur-state) var(--ease-out);
  }

  .skip:focus-visible {
    transform: translateY(0);
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    /* Opaque. Nothing on this page is see-through. */
    background: var(--color-ground);
    padding-inline: var(--space-6);
    border-bottom: var(--border-hair) solid var(--color-hairline);
  }

  .nav__rail {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    width: 100%;
    max-width: var(--rail);
    min-height: var(--nav-height);
    margin-inline: auto;
    padding-inline: var(--space-6);
    border-inline: var(--border-hair) solid var(--color-hairline);
  }

  .nav__home {
    display: flex;
    align-items: center;
    /* 60px, not 34: the knotwork and the eye were still unreadable at 34, 44
       and 52 on a real window. At 60 the mark, not the padding, is what sets
       the bar's height, which is why --nav-height went to 80px with it. The
       word beside it grew with it: a 60px mark against 17px type reads as a
       mark with a caption, not as one object. */
    gap: var(--space-3);
    margin-right: auto;
    text-decoration: none;
    font-weight: 600;
    /* A step off the scale, derived rather than written: --text-lg is only
       1.22x --text-md at the small end and the word has to be at least 1.3x.
       Multiplying the token keeps the fluid clamp and keeps the raw value out
       of this file. 23 -> 27px. */
    font-size: calc(var(--text-md) * 1.3);
    letter-spacing: -0.01em;
  }

  /* The whole anchor is the target, so the pointer anywhere on it fires the
     state, but only the word takes the colour: the mark keeps its own palette.
     --color-mark, not --color-accent: the accent is 1.69:1 on the light ground
     and this is text. Nothing moves or resizes, so a hover never touches the
     80px bar. */
  .nav__home span {
    transition: color var(--dur-state) var(--ease-out);
  }

  .nav__home:hover span,
  .nav__home:focus-visible span {
    color: var(--color-mark);
  }

  .nav__links {
    display: flex;
    align-items: center;
    /* One row, always. A mark and the word it names are one object; the pair
       breaking over two lines reads as two separate controls, and it happened
       on a real window. Neither this list nor a link inside it may wrap. */
    flex-wrap: nowrap;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
    /* The list is a flex row, so a link is a flex item and would shrink below
       its own content before the rail gave up any width. */
    flex: none;
    gap: var(--space-2);
    color: var(--color-ink-muted);
    text-decoration: none;
    white-space: nowrap;
    padding-block: var(--space-3);
  }

  .nav__links a:hover {
    color: var(--color-ink);
  }

  /* A link with no label. The mark IS the link, so it carries the hit target
     the word used to give it: 44px, the same as the theme control beside it,
     and it is the accessible name on the anchor rather than on the mark. */
  .nav__icon {
    justify-content: center;
    min-height: 44px;
    /* Padded out to the target, then pulled back by the same amount, so the
       box grows without moving the row's rhythm off the gap it is set on. */
    padding-block: 0;
    padding-inline: var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
  }

  /* GitHub's mark is filled and monochrome by its own brand guidance, so it
     takes the link's colour and lights with it. It is NOT --color-mark: the
     amber is this site's mark colour and this is somebody else's mark. */
  .nav__icon :global(svg) {
    display: block;
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .page {
    display: flex;
    flex-direction: column;
    /* Bands touch, so the vertical rules run unbroken from the nav down. */
    gap: 0;
  }

  /* A band like the Row above it: the horizontal rule on the band, the two
     vertical rules on the rail, so the grid's lines run into the footer. */
  .foot {
    padding-inline: var(--space-6);
    border-top: var(--border-hair) solid var(--color-hairline);
  }

  .foot__rail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    width: 100%;
    max-width: var(--rail);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) var(--space-7);
    border-inline: var(--border-hair) solid var(--color-hairline);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .foot__rail p {
    margin: 0;
    max-width: none;
  }

  .foot__credit {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  /* The signature is drawn in ink, the rest of the line stays muted: one step
     of colour is what makes a name read as a name rather than as small print. */
  .foot__maker {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    color: var(--color-ink);
    text-decoration: none;
  }

  .foot__domain {
    color: var(--color-ink-muted);
    text-underline-offset: 4px;
    transition: color var(--dur-state) var(--ease-out);
  }

  /* The underline goes on the domain and never under the lockup: a rule
     touching a logotype is what its clear space exists to stop. */
  .foot__maker:hover .foot__domain,
  .foot__maker:focus-visible .foot__domain {
    color: var(--color-ink);
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .foot {
      padding-inline: 0;
    }

    .foot__rail {
      padding: var(--space-5) var(--space-4) var(--space-6);
      border-inline: 0;
    }

    .nav {
      padding-inline: 0;
    }

    .nav__rail {
      padding-inline: var(--space-4);
      gap: var(--space-4);
      border-inline: 0;
    }

    .nav__links {
      gap: var(--space-4);
    }
  }
</style>
