---
/*
 * The docs index. Deliberately not the docs shell: this page IS the table of
 * contents, so putting it beside a sidebar that says the same thing twice
 * would be the page arguing with itself.
 */
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import { docsNav } from '../../lib/docs-nav';

const nav = await docsNav();
const count = nav.reduce((n, group) => n + group.pages.length, 0);
---

<Base
  title="Svipall documentation"
  description="The command line, the local API, the MCP tools, and the measurements behind every number on this site."
  surface="docs"
>
  <Row num="00" label="Documentation">
    <div class="beat">
      <h1 class="beat__head">{count} pages, and the log behind each one.</h1>
      <p class="beat__lede">
        Written from the files that ship with the code. Every page names the one
        it came from, so a claim here can be checked against the repository
        rather than taken on trust.
      </p>
    </div>

    {
      nav.map((group) => (
        <section class="group">
          <h2 class="group__name">{group.name}</h2>
          <ul class="group__list">
            {group.pages.map((page) => (
              <li class="group__item">
                <a class="group__link" href={`/docs/${page.id}`}>
                  <span class="group__title">{page.title}</span>
                  <span class="group__summary">{page.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </Row>
</Base>

<style>
  .beat {
    margin-bottom: var(--space-7);
  }

  .beat__head {
    font-size: var(--text-2xl);
    max-width: 18ch;
  }

  .beat__lede {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--color-ink-muted);
  }

  .group + .group {
    margin-top: var(--space-7);
  }

  .group__name {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* The seams are the 1px gaps in the grid, showing the container's own
     background. Per-child borders need nth-child rules that hold for exactly
     one item count, and these groups have four different ones. */
  .group__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--border-hair);
    padding: var(--border-hair);
    background: var(--color-hairline);
  }

  /* Two columns rather than auto-fill, and the last odd item spans, because an
     empty slot in this grid is a hole showing the container's own background
     as a solid block. auto-fill only collapses a track that is empty in every
     row, so it does not help the last row of a group with an odd count. The
     home's lists solve it exactly this way and the groups here run 2, 3, 3
     and 4 items. */
  .group__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  /* A spanning card with a stacked title reads as a card with a missing
     neighbour, because the whole right half is empty. Across the full width
     it lays out as a row instead, which is a deliberate shape rather than a
     gap. */
  .group__item:last-child:nth-child(odd) .group__link {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-5);
  }

  .group__item {
    max-width: none;
    background: var(--color-cell);
  }

  .group__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    text-decoration: none;
    transition: background var(--dur-state) var(--ease-out);
  }

  .group__link:hover {
    background: var(--color-ground);
  }

  .group__title {
    font-weight: 600;
  }

  .group__summary {
    max-width: 46ch;
    font-size: var(--text-2xs);
    line-height: var(--leading-body);
    color: var(--color-ink-muted);
  }
</style>
