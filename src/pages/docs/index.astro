---
/*
 * The docs index. Deliberately not the docs shell: this page IS the table of
 * contents, so putting it beside a sidebar that says the same thing twice
 * would be the page arguing with itself.
 */
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import { docsNav } from '../../lib/docs-nav';

const nav = await docsNav();
const count = nav.reduce((n, group) => n + group.pages.length, 0);
---

<Base
  title="Svipall documentation"
  description="The command line, the local API, the MCP tools, and the measurements behind every number on this site."
>
  <Row num="00" label="Documentation">
    <div class="beat">
      <h1 class="beat__head">{count} pages, and the log behind each one.</h1>
      <p class="beat__lede">
        Written from the files that ship with the code. Every page names the one
        it came from, so a claim here can be checked against the repository
        rather than taken on trust.
      </p>
    </div>

    {
      nav.map((group) => (
        <section class="group">
          <h2 class="group__name">{group.name}</h2>
          {/* The column count divides the group exactly, so no slot is ever
              empty. The counts are known at build time; guessing with auto-fill
              is what left a hole in the first place. */}
          <ul class="group__list" style={`--cols: ${group.pages.length % 3 === 0 ? 3 : 2}`}>
            {group.pages.map((page) => (
              <li class="group__item">
                <a class="group__link" href={`/docs/${page.id}`}>
                  <span class="group__title">{page.title}</span>
                  <span class="group__summary">{page.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </Row>
</Base>

<style>
  .beat {
    margin-bottom: var(--space-7);
  }

  .beat__head {
    font-size: var(--text-2xl);
    /* ptah-allow: measure - a heading, not body copy. The 45-75ch window is a
       body measure; ragging a heading tighter is the point of setting it. */
    max-width: 18ch; /* ptah-allow: measure */
  }

  .beat__lede {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--color-ink-muted);
  }

  .group + .group {
    margin-top: var(--space-7);
  }

  .group__name {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* The seams are the 1px gaps in the grid, showing the container's own
     background. Per-child borders need nth-child rules that hold for exactly
     one item count, and these groups have four different ones. */
  /* The seams are the 1px gaps showing the container's own background, so an
     empty slot is a hole rather than a blank. Rather than let one appear and
     then patch it - the last card used to span the row and lay its text out
     differently from every card above it, which read as broken - the column
     count is chosen per group so the grid always divides exactly. Groups of
     three get three columns; everything else gets two. */
  .group__list {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
    gap: var(--border-hair);
    padding: var(--border-hair);
    background: var(--color-hairline);
  }

  @media (max-width: 860px) {
    .group__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .group__item {
    max-width: none;
    background: var(--color-cell);
  }

  .group__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    text-decoration: none;
    transition: background var(--dur-state) var(--ease-out);
  }

  .group__link:hover {
    background: var(--color-ground);
  }

  .group__title {
    font-weight: 600;
  }

  .group__summary {
    max-width: 46ch;
    /* Was --text-2xs, which set the same role two steps below the home's card
       body at the same viewport. */
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--color-ink-muted);
  }
</style>
