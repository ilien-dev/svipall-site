---
/*
 * The docs index. Deliberately not the docs shell: this page IS the table of
 * contents, so putting it beside a sidebar that says the same thing twice
 * would be the page arguing with itself.
 */
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import Glyph from '../../components/Glyph.astro';
import { docsNav, GROUP_MARKS } from '../../lib/docs-nav';

const nav = await docsNav();
const count = nav.reduce((n, group) => n + group.pages.length, 0);
---

<Base
  title="Svipall documentation"
  description="The command line, the local API, the MCP tools, and the measurements behind every number on this site."
>
  <Row>
    <div class="beat">
      <h1 class="beat__head">{count} pages, and the log behind each one.</h1>
      <p class="beat__lede">
        Written from the files that ship with the code. Every page names the one
        it came from, so a claim here can be checked against the repository
        rather than taken on trust.
      </p>
    </div>

    {
      nav.map((group) => (
        <section class="group">
          <h2 class="group__name">
            <Glyph name={GROUP_MARKS[group.name]} class="group__mark" />
            {group.name}
          </h2>
          {/* The column count divides the group exactly, so no slot is ever
              empty. The counts are known at build time; guessing with auto-fill
              is what left a hole in the first place. */}
          <ul class="group__list">
            {group.pages.map((page) => (
              <li class="group__item">
                <a class="group__link" href={`/docs/${page.id}`}>
                  <span class="group__title">{page.title}</span>
                  <span class="group__summary">{page.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </Row>
</Base>

<style>
  .beat__head {
    font-size: var(--text-2xl);
    /* ptah-allow: measure - a heading, not body copy. The 45-75ch window is a
       body measure; ragging a heading tighter is the point of setting it. */
    max-width: 18ch; /* ptah-allow: measure */
  }

  .beat__lede {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--color-ink-muted);
  }

  /* The mark sits IN THE LINE with the label, never above it: a mark stacked
     over a heading is the icon tile R-G3-10 refuses, whatever it is drawn
     with. */
  .group__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* The seams are the 1px gaps in the grid, showing the container's own
     background. Per-child borders need nth-child rules that hold for exactly
     one item count, and these groups have four different ones. */
  /* One column. Four groups laid out as grids of bordered blocks was four
     card walls, which DIRECTION.md's component list rules out by name, and it
     turned a twelve-item contents list into a wall of boxes. A ruled list of
     rows is what a contents list is, and it cannot leave an empty slot at any
     item count - which is the second problem it solves. */
  .group__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--border-hair);
    padding: var(--border-hair);
    background: var(--color-hairline);
  }

  .group__item {
    max-width: none;
    background: var(--color-cell);
  }

  /* Title left, summary right: the row reads across, like every other ruled
     list on this site. */
  .group__link {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    transition: background var(--dur-state) var(--ease-out);
  }

  @media (max-width: 700px) {
    .group__link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
  }

  .group__link:hover {
    background: var(--color-ground);
  }

  .group__title {
    font-weight: 600;
  }

  .group__summary {
    max-width: 46ch;
    /* Was --text-2xs, which set the same role two steps below the home's card
       body at the same viewport. */
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--color-ink-muted);
  }
</style>
