---
/*
 * The product page, "heat" direction. The markup lives in
 * src/home/home.body.html (no braces: Astro would read them as expressions),
 * its tokens and motion in src/styles/home.css, and its moving parts (the 3D
 * heat field, the gate player, the before/after) in src/scripts/home.ts. This
 * file adds what a real page needs on top: the head (SEO), the shared theme,
 * the release tag, the set-up tabs, the questions, the copy button and the
 * maker's credit.
 *
 * The theme is the SAME one the docs use: Starlight keeps it in
 * localStorage under `starlight-theme` and in <html data-theme>. Both pages
 * read and write that one key, so switching on one switches the other.
 */
import body from '../home/home.body.html?raw';
import '../styles/home.css';
import '../styles/page.css';
import '../styles/transitions.css';
import MakerMark from '../components/MakerMark.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { latestRelease, RELEASES_URL } from '../lib/release';

/* The design's own header is replaced by the site's one header, SiteHeader,
   the same component the docs render. */
const headerAt = body.search(/<header class="in"/);
const headerEnd = body.indexOf('</header>', headerAt) + '</header>'.length;
if (headerAt < 0 || headerEnd < headerAt) throw new Error('index: the design no longer has its header');
const before = body.slice(0, headerAt);
const release = await latestRelease();

/* The release sits in the hero, under the two calls to action, rather than in
   the header: it is news about the product, not navigation. Not drawn at all
   when the build could not read it (see lib/release). */
const cta = /Watch it work<\/a>\r?\n<\/div>/;
const afterHeader = body.slice(headerEnd);
if (!cta.test(afterHeader)) throw new Error('index: the hero no longer has its two calls to action');
const releaseTag = release
  ? `<a class="hero-ver in3" href="${release.url}"><span class="hero-ver-dot" aria-hidden="true"></span><b>${release.version}</b><span>Released ${release.date}</span><span class="hero-ver-go">Release notes<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span></a>`
  : '';
const after = afterHeader.replace(cta, (m) => m + releaseTag);

const site = 'https://svipall.ilien.dev';
const title = 'Svipall — free web access for your AI, no API key';
const description =
  'Svipall is a free, open-source add-on that lets Claude, Cursor, Codex and other AI apps read websites, get past "checking your browser" screens, search without a key, watch videos and track page changes. Runs on your computer; no account.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Svipall',
  url: site,
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  codeRepository: 'https://github.com/ilien-dev/svipall',
  ...(release ? { softwareVersion: release.version.replace(/^v/, '') } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="give Claude web access, free web search MCP server, MCP server no API key, AI web browsing, read any website with AI, AI price tracker, summarize video with AI, local web scraping MCP, Firecrawl alternative, Tavily alternative" />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/urbanist-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Svipall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og.png`} />
    <meta name="theme-color" content="#050506" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3F1EF" media="(prefers-color-scheme: light)" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        let t;
        try { t = localStorage.getItem('starlight-theme'); } catch {}
        document.documentElement.dataset.themeChoice = t === 'light' || t === 'dark' ? t : 'system';
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
      try{document.documentElement.style.setProperty('--sky-delay',-(Date.now()%50000)+'ms')}catch(e){}try{if(sessionStorage.getItem('svt')){document.documentElement.classList.add('vt');sessionStorage.removeItem('svt')}}catch(e){}addEventListener('pageswap',function(e){if(e.viewTransition){try{sessionStorage.setItem('svt','1')}catch(_){}}});
    </script>
  </head>
  <body>
    <Fragment set:html={before} /><header class="site-bar"><SiteHeader home /></header><Fragment set:html={after} />
    <p class="credit">
      <a href="https://ilien.dev" aria-label="Made by ilien">Made by <MakerMark size="1.6em" /></a>
      <span>· <a href={RELEASES_URL}>Releases</a></span>
    </p>
    <script is:inline>
      /* A block: the router runs this again each time the page comes back, and
         top-level const in a classic script cannot be declared twice. */
      {
      /* Set up: one tab per way in. Switching replays the little conversation. */
      const tabs = [...document.querySelectorAll('[data-setup]')];
      /* Never a static swap: the open panel leaves toward the side you moved
         away from, the next one enters from the other, and the stage animates
         its height between the two. Reduced motion swaps at once. */
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let seq = 0;
      const pick = (tab, focus) => {
        const next = document.getElementById(tab.getAttribute('aria-controls'));
        const cur = document.querySelector('.spanel:not([hidden])');
        const from = tabs.findIndex((t) => cur && t.getAttribute('aria-controls') === cur.id);
        const dir = tabs.indexOf(tab) >= from ? 1 : -1;
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        }
        if (focus) tab.focus();
        if (!next || cur === next) return;
        const run = ++seq;
        const stage = next.parentElement;
        const show = () => {
          if (run !== seq) return;
          const h0 = stage.offsetHeight;
          for (const p of document.querySelectorAll('.spanel')) { p.classList.remove('s-in', 's-out'); p.hidden = p !== next; }
          next.style.setProperty('--dir', dir);
          void next.offsetWidth;
          next.classList.add('s-in');
          for (const m of next.querySelectorAll('.smsg')) { m.style.animation = 'none'; void m.offsetWidth; m.style.animation = ''; }
          if (reduce) return;
          const h1 = stage.offsetHeight;
          stage.style.height = `${h0}px`;
          void stage.offsetHeight;
          stage.style.transition = 'height .4s cubic-bezier(.2,.7,.2,1)';
          stage.style.height = `${h1}px`;
          setTimeout(() => { if (run === seq) { stage.style.height = ''; stage.style.transition = ''; } }, 420);
        };
        if (cur && !reduce) {
          cur.style.setProperty('--dir', dir);
          cur.classList.remove('s-in');
          cur.classList.add('s-out');
          setTimeout(show, 200);
        } else show();
      };
      tabs.forEach((tab, i) => {
        tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1;
        tab.addEventListener('click', () => pick(tab, false));
        tab.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (step) { e.preventDefault(); pick(tabs[(i + step + tabs.length) % tabs.length], true); }
        });
      });

      /* Questions open and close with motion, every time: the row grows to
         its answer while the answer rises in, and shrinks back while it
         fades out. A click during the motion waits for it. */
      for (const d of document.querySelectorAll('details.faq')) {
        const sum = d.querySelector('summary');
        const ans = d.querySelector('p');
        let moving = false;
        sum.addEventListener('click', (e) => {
          if (reduce || !ans) return;
          e.preventDefault();
          if (moving) return;
          moving = true;
          const ease = 'cubic-bezier(.2,.7,.2,1)';
          const from = d.offsetHeight;
          const shut = sum.offsetHeight + parseFloat(getComputedStyle(d).borderBottomWidth);
          if (!d.open) {
            d.open = true;
            const to = d.offsetHeight;
            ans.animate([{ opacity: 0, transform: 'translateY(-10px)' }, { opacity: 1, transform: 'none' }], { duration: 380, easing: ease });
            d.animate({ height: [from + 'px', to + 'px'] }, { duration: 380, easing: ease }).finished.finally(() => { moving = false; });
          } else {
            ans.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(-10px)' }], { duration: 260, easing: 'ease-in', fill: 'forwards' });
            d.animate({ height: [from + 'px', shut + 'px'] }, { duration: 300, easing: ease }).finished.finally(() => {
              d.open = false;
              for (const a of ans.getAnimations()) a.cancel();
              moving = false;
            });
          }
        });
      }

      /* Copy exactly the text shown in the box beside the button. */
      for (const button of document.querySelectorAll('[data-copy-from]')) {
        const label = button.querySelector('[data-copy-label]');
        button.addEventListener('click', async () => {
          const source = document.getElementById(button.dataset.copyFrom);
          const say = (text) => {
            if (!label) return;
            label.textContent = text;
            label.classList.remove('flash');
            void label.offsetWidth;
            label.classList.add('flash');
          };
          try {
            await navigator.clipboard.writeText(source ? source.textContent : '');
            say('Copied');
          } catch {
            say('Select and copy');
          }
          setTimeout(() => say('Copy'), 2400);
        });
      }
      }
    </script>
    <script>
      /* Moving to the docs and back without a reload; also the theme switch. */
      import '../scripts/site-router';
      /* The heat field, the gate player and the before/after. */
      import '../scripts/home';
    </script>
  </body>
</html>
